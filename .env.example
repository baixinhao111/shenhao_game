# 服务监听端口（打包后前后端同端口，手机浏览器直接访问 http://你的服务器IP:3080 即可）
PORT=3080

# JWT 会话签名密钥（部署到公网请务必改成随机长字符串）
JWT_SECRET=tianshu_shenhao_secret_change_me_2026

# DeepSeek API 配置（使用性价比最高的 deepseek-chat）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 每个玩家每日 AI 聊天最大条数（小圈子推荐 60~120）
AI_DAILY_MESSAGE_LIMIT=80

# 管理员口令（注册时若用户名是 admin 或登录后台使用此口令）
ADMIN_SECRET=tianshu_gm_2026

# 数据库文件路径（相对于项目根目录）
DB_PATH=./data/tianshu.sqlite
